{
  "schema": "js-reverse-ops-public-benchmark-cases-v1",
  "cases": [
    {
      "id": "pattern_xhr_open_rewrite",
      "type": "pattern",
      "text": "XMLHttpRequest.open rewrites URL, global token missing, right length token fails, runtime cookie required",
      "expect": {
        "top_pattern": "xhr_open_url_rewrite_runtime_replay",
        "min_score": 0.4,
        "playbook": "playbooks/xhr-open-url-rewrite-runtime-replay.md",
        "hook_preset": "xhr-open-rewrite"
      }
    },
    {
      "id": "pattern_bootstrap_digest",
      "type": "pattern",
      "text": "cookie written multiple times during bootstrap, digest chain produces wrapped cookie, short ttl",
      "expect": {
        "top_pattern": "bootstrap_digest_ladder",
        "min_score": 0.6,
        "playbook": "playbooks/bootstrap-digest-ladder.md",
        "hook_preset": "cookie-write"
      }
    },
    {
      "id": "pattern_transport_profile",
      "type": "pattern",
      "text": "same fields succeed in one client but fail in another, headers look correct, signer accepted in browser but rejected in script",
      "expect": {
        "top_pattern": "transport_profile_ladder",
        "min_score": 0.5,
        "playbook": "playbooks/transport-profile-ladder.md",
        "hook_preset": "fetch-signature"
      }
    },
    {
      "id": "route_xhr_notes_to_playbook",
      "type": "route",
      "target": "examples/sample-target.js",
      "notes": "XMLHttpRequest.open rewrites URL and global token missing; transport hook adds query",
      "expect": {
        "family": "xhr-open-url-rewrite-runtime-replay",
        "stage": "runtime",
        "playbook": "playbooks/xhr-open-url-rewrite-runtime-replay.md",
        "hook_preset": "xhr-open-rewrite",
        "next_lane": "runtime-hook-capture"
      }
    },
    {
      "id": "route_wasm_notes_to_playbook",
      "type": "route",
      "target": "examples/sample-target.js",
      "notes": "server time input is captured first, then wasm signer and module helper compute a time gated request",
      "expect": {
        "family": "server-time-gated-wasm-signer",
        "stage": "runtime",
        "playbook": "playbooks/server-time-gated-wasm-signer.md",
        "hook_preset": "business-function",
        "next_lane": "crypto-entry-discovery"
      }
    },
    {
      "id": "route_html_sample",
      "type": "route",
      "target": "examples/sample-page.html",
      "expect": {
        "family": "html-page",
        "stage": "locate",
        "sequence_item": "scripts/extract_page_contract.js",
        "next_lane": "locate-request-contract"
      }
    },
    {
      "id": "runtime_capture_wasm_storage_gap",
      "type": "runtime_capture",
      "notes": "final fetch adds signature header; token seed is read from localStorage and a wasm module helper computes nonce before replay fails",
      "expect": {
        "missing_surface": "wasm-worker-boundary",
        "recommended_preset": "business-function",
        "capture_mode": "summary"
      }
    },
    {
      "id": "env_patch_response_shape_divergence",
      "type": "env_patch",
      "divergence_record": "examples/sample-replay-divergent-record.json",
      "notes": "replay request is accepted but response shape returns error instead of items; likely missing bootstrap prerequisite or dataset branch state",
      "expect": {
        "first_divergence_kind": "shape mismatch",
        "recommended_patch": "response-shape-prerequisite",
        "matched_signal": "shape mismatch"
      }
    },
    {
      "id": "static_toolchain_ast_then_runtime",
      "type": "static_toolchain",
      "target": "examples/sample-static-obfuscated.js",
      "notes": "constant fold the request builder, recover API route string, then verify against runtime or replay evidence before promoting claims",
      "expect": {
        "recommended_step": "ast-readability-pass",
        "selected_step": "runtime-correlation",
        "local_script": "scripts/run_ast_pipeline.js"
      }
    },
    {
      "id": "static_toolchain_sourcemap_first",
      "type": "static_toolchain",
      "target": "examples/sample-sourcemap-bundle.js",
      "notes": "source map is available from sourceMappingURL; recover original source before AST cleanup or semantic renaming",
      "expect": {
        "recommended_step": "source-map-recovery",
        "selected_step": "runtime-correlation",
        "local_script": "scripts/trace_module_graph.js",
        "source_mapping_url": "sample-sourcemap-bundle.js.map"
      }
    },
    {
      "id": "static_truth_decoy_stays_inferred",
      "type": "static_truth",
      "target": "examples/sample-static-decoy.js",
      "out": "tmp/static-decoy-recovered.js",
      "expect": {
        "state": "inferred",
        "delivery_ready": false,
        "risk_signal": "decoy-branch"
      }
    },
    {
      "id": "static_truth_runtime_divergence_blocks_delivery",
      "type": "static_truth",
      "target": "examples/sample-static-readable-wrong.js",
      "runtime_evidence": "examples/sample-static-runtime-divergence.json",
      "expect": {
        "state": "divergent",
        "delivery_ready": false,
        "risk_signal": "runtime-divergence"
      }
    },
    {
      "id": "domain_handoff_wasm_boundary",
      "type": "domain_handoff",
      "notes": "page loads WebAssembly.instantiateStreaming for signer.wasm; JS glue calls Module.ccall to compute nonce before final fetch",
      "expect": {
        "recommended_handoff": "wasm-boundary",
        "matched_signal": "webassembly",
        "boundary_artifact": "wasm asset URL or local file path"
      }
    },
    {
      "id": "domain_handoff_packet_boundary",
